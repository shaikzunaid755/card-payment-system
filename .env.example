# copy this file to .env and change the values

DEBUG=True
DJANGO_SECRET_KEY=change-this-django-secret-key-please-1234567890
ALLOWED_HOSTS=127.0.0.1,localhost

# this key is shared by Django (creates the token) and FastAPI (checks the token)
# both services MUST have the same value
JWT_SECRET_KEY=change-this-shared-jwt-secret-key-1234567890

DB_NAME=card_payment_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# chance (0 to 1) that a simulated payment succeeds
PAYMENT_SUCCESS_RATE=0.8
