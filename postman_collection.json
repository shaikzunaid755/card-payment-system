{
  "info": {
    "name": "Credit Card Payment System",
    "description": "Run the requests in order: Register, Login (saves the token), Add Card (saves card_id), Make Payment. Django runs on port 8000, FastAPI on port 8001.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "django_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "fastapi_url",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "card_id",
      "value": "1"
    },
    {
      "key": "payment_reference",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentication (Django)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/auth/register/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john\",\n  \"email\": \"john@example.com\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Str0ng!Passw0rd\",\n  \"confirm_password\": \"Str0ng!Passw0rd\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (saves tokens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/auth/login/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john\",\n  \"password\": \"Str0ng!Passw0rd\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('access_token', data.access);",
                  "pm.collectionVariables.set('refresh_token', data.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/auth/token/refresh/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "auth",
                "token",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('access_token', data.access);"
                ]
              }
            }
          ]
        },
        {
          "name": "My profile (protected route)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_url}}/api/auth/me/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/auth/logout/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Cards (Django)",
      "item": [
        {
          "name": "Add card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_url}}/api/cards/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "cards"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardholder_name\": \"John Doe\",\n  \"card_type\": \"CREDIT\",\n  \"card_number\": \"4111 1111 1111 1111\",\n  \"cvv\": \"123\",\n  \"expiry_month\": 12,\n  \"expiry_year\": 2030\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.id) { pm.collectionVariables.set('card_id', data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "View saved cards",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_url}}/api/cards/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "cards"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Delete card",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{django_url}}/api/cards/{{card_id}}/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "cards",
                "{{card_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Payments (FastAPI)",
      "item": [
        {
          "name": "Make payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{fastapi_url}}/payments/",
              "host": [
                "{{fastapi_url}}"
              ],
              "path": [
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"amount\": \"499.50\",\n  \"currency\": \"INR\",\n  \"description\": \"Test order\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.reference) { pm.collectionVariables.set('payment_reference', data.reference); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get payment by reference",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{fastapi_url}}/payments/{{payment_reference}}",
              "host": [
                "{{fastapi_url}}"
              ],
              "path": [
                "payments",
                "{{payment_reference}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{fastapi_url}}/health",
              "host": [
                "{{fastapi_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "4. Transactions (Django)",
      "item": [
        {
          "name": "Transaction history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_url}}/api/transactions/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_url}}/api/transactions/?status=SUCCESS",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "SUCCESS"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by amount",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_url}}/api/transactions/?min_amount=100&max_amount=1000",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "min_amount",
                  "value": "100"
                },
                {
                  "key": "max_amount",
                  "value": "1000"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_url}}/api/transactions/?date_from=2026-10-01&date_to=2026-12-31",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "date_from",
                  "value": "2026-10-01"
                },
                {
                  "key": "date_to",
                  "value": "2026-12-31"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Transaction detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_url}}/api/transactions/1/",
              "host": [
                "{{django_url}}"
              ],
              "path": [
                "api",
                "transactions",
                "1"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
